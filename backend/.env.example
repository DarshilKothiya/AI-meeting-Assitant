# ========================================
# AI Meeting Assistant - Environment Configuration
# ========================================

# Groq API Configuration for AI Meeting Summaries (REQUIRED for summarization)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model name
# Recommended models: openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Connection URL
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# Note: If MongoDB is unavailable, the system automatically falls back to in-memory storage.
MONGODB_URL=mongodb://localhost:27017

# Faster-Whisper Speech Recognition Configuration
# Device: "cpu" or "cuda"
WHISPER_DEVICE=cpu
# Whisper model size: "tiny", "base", "small", "medium", "large-v3"
WHISPER_MODEL=tiny

# Application Settings
DEBUG=True
HOST=localhost
PORT=8000
